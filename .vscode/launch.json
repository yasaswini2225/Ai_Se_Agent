{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DevPulse AI: Server & Full App (run.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    {
      "name": "DevPulse AI: Frontend Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "DevPulse: Full Stack Dev (Backend + Frontend)",
      "configurations": ["DevPulse AI: Server & Full App (run.py)", "DevPulse AI: Frontend Dev Server"]
    }
  ]
}
